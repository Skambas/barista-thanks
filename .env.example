# Скопіюй у .env для локального запуску. У Portainer ті самі змінні додаються в
# полі "Environment variables" стеку (там лапки не потрібні).

# Порт усередині контейнера (за замовчуванням 3000)
PORT=3000

# Посилання на банку Monobank, https://send.monobank.ua/jar/...
# Порожньо: кнопки чайових на сайті не буде зовсім
MONOBANK_JAR_URL=

# Адреса сайту, яку скануватиме QR (постійний HTTPS-домен). Для Open Graph і QR-скрипта
SITE_URL=https://kava.example.com

# Підпис баристи на листочку й на картинці для сторіз
BARISTA_SIGNATURE="- Ваша бариста🦊 ☕"

# Токен бота від @BotFather. Порожньо: бот вимкнено, фрази лишаються як є
# Не публікуй токен і не кидай його в git
TELEGRAM_BOT_TOKEN=

# Telegram ID адміністраторів через кому, 123456789,987654321
# Свій ID бот покаже у відповідь на /start, якщо список порожній
ADMIN_TELEGRAM_IDS=

# ---- Лише для docker-compose / Portainer ----
# Назва Docker-мережі Nginx Proxy Manager (дивись у Portainer: Containers → NPM → Networks)
PROXY_NETWORK=nginx-proxy-manager_default
# Образ у GHCR, якщо не хочеш правити рядок image у docker-compose.yml
# IMAGE=ghcr.io/owner/barista-thanks:latest

# ---- Необов'язкове ----
# TRUST_PROXY=false   # лише якщо порт відкрито в інтернет напряму, без NPM
# LOG_LEVEL=info
# DB_PATH=./data/phrases.db   # шлях до SQLite поза Docker

# ---- Лише для npm run dev (Vite, порт 5173) ----
# VITE_MONOBANK_JAR_URL=https://send.monobank.ua/jar/...
# VITE_BARISTA_SIGNATURE="- Ваша бариста🦊 ☕"